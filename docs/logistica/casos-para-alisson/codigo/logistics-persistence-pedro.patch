+                    'entrega_id' => $id, 'despacho_id' => $dispatchId,
+                    'despacho_detalle_id' => $detail['despacho_detalle_id'], 'cantidad' => $detail['cantidad'],
+                    'cantidad_rechazada' => $detail['cantidad_rechazada'],
