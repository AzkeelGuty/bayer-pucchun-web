APP_NAME="Bayer-Pucchun Data Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://su-dominio.com
# Opcional: úselo cuando el Document Root público está separado del proyecto (ej. cPanel public_html).
BAYER_PUBLIC_ROOT=
APP_TIMEZONE=America/Lima
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bayer_pucchun
DB_USER=bayer_user
DB_PASS=cambiar_clave
SESSION_NAME=bayer_pucchun_session
API_ENABLED=false
# Duración del Bearer token emitido tras login API (segundos). 28800 = 8 horas.
API_TOKEN_TTL=28800

# Emisión electrónica SUNAT. Configurar únicamente cuando la empresa ya sea emisor.
# No introducir contraseñas reales en el repositorio.
SUNAT_ENABLED=false
SUNAT_MODE=beta
SUNAT_ALLOW_PRODUCTION=false
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
# Archivo PEM real con clave privada y certificado, fuera de public_html.
# Colocar en storage/private/sunat/certificado.pem (no versionado).
SUNAT_CERT_PEM_PATH=
SUNAT_SERIE_FACTURA=
SUNAT_CORRELATIVO_INICIAL=1
SUNAT_UBIGEO=
SUNAT_DEPARTAMENTO=
SUNAT_PROVINCIA=
SUNAT_DISTRITO=
SUNAT_DIRECCION=
SUNAT_NOMBRE_COMERCIAL=
# Especificar por comprobante la clasificación gravada y si el precio incluye IGV.
SUNAT_IGV_PORCENTAJE=18
