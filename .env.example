APP_NAME="Bayer-Pucchun Data Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://su-dominio.com
# Opcional: úselo cuando el Document Root público está separado del proyecto (ej. cPanel public_html).
BAYER_PUBLIC_ROOT=
APP_TIMEZONE=America/Lima
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bayer_pucchun
DB_USER=bayer_user
DB_PASS=cambiar_clave
SESSION_NAME=bayer_pucchun_session
API_ENABLED=false
# Duración del Bearer token emitido tras login API (segundos). 28800 = 8 horas.
API_TOKEN_TTL=28800
